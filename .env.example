# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Metadata API (Mandatory)
TMDB_API_KEY=your_tmdb_v3_api_key_here

# Database (PostgreSQL / Neon Serverless)
DATABASE_URL=postgres://user:password@ep-sample-12345.us-east-2.aws.neon.tech/cinely?sslmode=require

# Authentication (NextAuth v5)
AUTH_SECRET=generate_with_openssl_rand_hex_32
NEXTAUTH_URL=http://localhost:3000

# Proxy & Scraping Egress
SCRAPE_PROXY_URL=http://127.0.0.1:8888
SCRAPE_PREFER_DIRECT=1
FLARESOLVERR_URL=http://localhost:8191/v1

# Feature Flags (Optional / Flipt)
FLIPT_URL=
FLIPT_API_KEY=
